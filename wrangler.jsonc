{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Your production hostname. The zone must live in this Cloudflare account;
  // www -> apex is best done with a Cloudflare redirect rule, not a second
  // route (infra/www-redirect/ has a Worker for accounts without one).
  // Delete this line to deploy on the *.workers.dev subdomain instead.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],
  // Prerendered pages live at <path>/index.html; serve them at <path> (the
  // canonical URL) instead of redirecting to a trailing slash. The vite plugin
  // fills in `directory`.
  "assets": { "html_handling": "drop-trailing-slash" },
  // Workers Logs: request/exception logs in the Cloudflare dashboard, no code
  // needed. Sampled at 100%; lower head_sampling_rate on very high traffic.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-app",
      // Production database. Run `wrangler d1 create my-app` and paste the id
      // it prints here — local dev ignores it. The /deploy skill does this.
      "database_id": "REPLACE_ME",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // Create with `wrangler r2 bucket create my-app-files`. Holds profile photos.
      "bucket_name": "my-app-files"
    }
  ],
  // Per-IP throttle for public endpoints, applied in src/core/server/rate-limit.ts.
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Daily maintenance (src/core/jobs): purge expired sessions and
  // verification rows, remind and erase closed accounts. Handled by `scheduled` in src/server.ts.
  "triggers": { "crons": ["0 0 * * *"] }
}
