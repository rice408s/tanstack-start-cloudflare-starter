# The key list. Copy it to .dev.vars (gitignored — never commit it) and
# fill it in: cp .dev.vars.example .dev.vars
#
# Production values reach the Worker with `wrangler secret put <NAME>`
# (or `wrangler secret bulk` from a gitignored .prod.vars). Keep a copy
# in a password manager: a key that lives only in a dashboard gets lost.
# D1 and R2 need no credentials — they are bindings in wrangler.jsonc.
#
# Env is read at boot: restart the dev server after editing.

APP_URL=http://localhost:3000

# Signs session cookies. Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in — optional. Set BOTH to show "Continue with Google" (and
# One Tap); leave both empty and sign-in is by emailed code, plus GitHub if set.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# The client id must ALSO go in appConfig.googleClientId (One Tap needs it
# in the browser). See the /google-oauth skill.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in — optional. Set BOTH to show a "Continue with GitHub"
# button; leave both empty and there is no GitHub button. Create an OAuth app
# at https://github.com/settings/developers with the callback URL
# <APP_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (https://resend.com/api-keys) — optional. Without it every send is a
# logged no-op, and sign-in codes are printed to the dev server's log instead.
RESEND_API_KEY=
