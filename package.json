{
  "name": "tanstack-start-cloudflare-starter",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && bun scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "bun run build && wrangler deploy",
    "deploy:www": "wrangler deploy -c infra/www-redirect/wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "auth:generate": "bunx @better-auth/cli generate --config auth.cli-config.ts --output src/features/auth/schema.ts -y",
    "upload:marketing": "bun scripts/upload-marketing.ts",
    "og": "bun scripts/og-shot.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.40.1",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.25",
    "@tanstack/router-plugin": "1.168.18",
    "better-auth": "1.6.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@inlang/paraglide-js": "2.18.2",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/router-cli": "1.167.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/mdx": "2.0.14",
    "@types/node": "22.19.20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "jsdom": "28.1.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "sharp": "0.34.5",
    "simple-icons": "16.30.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "wrangler": "4.99.0",
    "yaml": "2.9.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss",
    "workerd",
    "sharp",
    "@biomejs/biome"
  ],
  "packageManager": "bun@1.3.11",
  "license": "MIT"
}
